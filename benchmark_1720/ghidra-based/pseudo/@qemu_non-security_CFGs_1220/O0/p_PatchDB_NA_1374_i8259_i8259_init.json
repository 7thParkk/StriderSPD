{
  "pseudo_code": [
    "qemu_irq * i8259_init(ISABus *bus,qemu_irq parent_irq)", 
    "", 
    "{", 
    "  qemu_irq *ppIVar1;", 
    "  undefined8 uVar2;", 
    "  DeviceState *pDVar3;", 
    "  qemu_irq pIVar4;", 
    "  qemu_irq parent_irq_local;", 
    "  ISABus *bus_local;", 
    "  int i;", 
    "  qemu_irq *irq_set;", 
    "  ISADevice *isadev;", 
    "  DeviceState *dev;", 
    "", 
    "  ppIVar1 = (qemu_irq *)g_malloc0_n(0x10,8);", 
    "  uVar2 = i8259_init_chip(\"isa-i8259\",bus,1);", 
    "  pDVar3 = (DeviceState *)", 
    "           object_dynamic_cast_assert(uVar2,\"device\",\"hw/intc/i8259.c\",0x1de,\"i8259_init\");", 
    "  qdev_connect_gpio_out(pDVar3,0,parent_irq);", 
    "  for (i = 0; i < 8; i = i + 1) {", 
    "    pIVar4 = (qemu_irq)qdev_get_gpio_in(pDVar3,i);", 
    "    ppIVar1[i] = pIVar4;", 
    "  }", 
    "  isa_pic = pDVar3;", 
    "  uVar2 = i8259_init_chip(\"isa-i8259\",bus,0);", 
    "  uVar2 = object_dynamic_cast_assert(uVar2,\"device\",\"hw/intc/i8259.c\",0x1e8,\"i8259_init\");", 
    "  qdev_connect_gpio_out(uVar2,0,ppIVar1[2]);", 
    "  for (i = 0; i < 8; i = i + 1) {", 
    "    pIVar4 = (qemu_irq)qdev_get_gpio_in(uVar2,i);", 
    "    ppIVar1[(long)i + 8] = pIVar4;", 
    "  }", 
    "  slave_pic = (PICCommonState *)", 
    "              object_dynamic_cast_assert(uVar2,\"pic-common\",\"hw/intc/i8259.c\",0x1ef,\"i8259_init\");", 
    "  return ppIVar1;", 
    "}"
  ]
}