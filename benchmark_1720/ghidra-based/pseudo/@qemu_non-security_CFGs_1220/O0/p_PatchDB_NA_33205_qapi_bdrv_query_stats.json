{
  "pseudo_code": [
    "BlockStats * bdrv_query_stats(BlockDriverState *bs,_Bool query_backing)", 
    "", 
    "{", 
    "  BlockStats *s_00;", 
    "  char *pcVar1;", 
    "  undefined8 uVar2;", 
    "  BlockDeviceStats *pBVar3;", 
    "  BlockStats *pBVar4;", 
    "  _Bool query_backing_local;", 
    "  BlockDriverState *bs_local;", 
    "  BlockStats *s;", 
    "", 
    "  s_00 = (BlockStats *)g_malloc0(0x48);", 
    "  pcVar1 = (char *)bdrv_get_device_name(bs);", 
    "  if (*pcVar1 != '\\0') {", 
    "    s_00->has_device = true;", 
    "    uVar2 = bdrv_get_device_name(bs);", 
    "    pcVar1 = (char *)g_strdup(uVar2);", 
    "    s_00->device = pcVar1;", 
    "  }", 
    "  pcVar1 = (char *)bdrv_get_node_name(bs);", 
    "  if (*pcVar1 != '\\0') {", 
    "    s_00->has_node_name = true;", 
    "    uVar2 = bdrv_get_node_name(bs);", 
    "    pcVar1 = (char *)g_strdup(uVar2);", 
    "    s_00->node_name = pcVar1;", 
    "  }", 
    "  pBVar3 = (BlockDeviceStats *)g_malloc0(0xa8);", 
    "  s_00->stats = pBVar3;", 
    "  if (bs->blk != (BlockBackend *)0x0) {", 
    "    bdrv_query_blk_stats(s_00,bs->blk);", 
    "  }", 
    "  s_00->stats->wr_highest_offset = bs->wr_highest_offset;", 
    "  if (bs->file != (BdrvChild *)0x0) {", 
    "    s_00->has_parent = true;", 
    "    pBVar4 = bdrv_query_stats(bs->file->bs,query_backing);", 
    "    s_00->parent = pBVar4;", 
    "  }", 
    "  if ((query_backing) && (bs->backing != (BdrvChild *)0x0)) {", 
    "    s_00->has_backing = true;", 
    "    pBVar4 = bdrv_query_stats(bs->backing->bs,true);", 
    "    s_00->backing = pBVar4;", 
    "  }", 
    "  return s_00;", 
    "}"
  ]
}