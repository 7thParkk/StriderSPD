{
  "pseudo_code": [
    "void qmp_send_key(KeyValueList *keys,_Bool has_hold_time,int64_t hold_time,Error **errp)", 
    "", 
    "{", 
    "  KeyValue *pKVar1;", 
    "  Error **errp_local;", 
    "  int64_t hold_time_local;", 
    "  _Bool has_hold_time_local;", 
    "  KeyValueList *keys_local;", 
    "  int count;", 
    "  KeyValueList *p;", 
    "  KeyValue **up;", 
    "", 
    "  up = (KeyValue **)0x0;", 
    "  count = 0;", 
    "  p = keys;", 
    "  hold_time_local = hold_time;", 
    "  if (!has_hold_time) {", 
    "    hold_time_local = 0;", 
    "  }", 
    "  for (; p != (KeyValueList *)0x0; p = p->next) {", 
    "    pKVar1 = copy_key_value((p->field_0).value);", 
    "    qemu_input_event_send_key(0,pKVar1,1);", 
    "    qemu_input_event_send_key_delay(hold_time_local & 0xffffffff);", 
    "    up = (KeyValue **)g_realloc(up,(long)(count + 1) * 8);", 
    "    pKVar1 = copy_key_value((p->field_0).value);", 
    "    up[count] = pKVar1;", 
    "    count = count + 1;", 
    "  }", 
    "  while (count != 0) {", 
    "    count = count + -1;", 
    "    qemu_input_event_send_key(0,up[count],0);", 
    "    qemu_input_event_send_key_delay(hold_time_local & 0xffffffff);", 
    "  }", 
    "  g_free(up);", 
    "  return;", 
    "}"
  ]
