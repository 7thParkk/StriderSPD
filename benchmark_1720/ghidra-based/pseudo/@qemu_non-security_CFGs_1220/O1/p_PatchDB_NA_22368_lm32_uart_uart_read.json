{
  "pseudo_code": [
    "undefined4 uart_read(long param_1,ulong param_2)", 
    "", 
    "{", 
    "  ulong uVar1;", 
    "  undefined4 uVar2;", 
    "", 
    "  if (param_2 < 0x20) {", 
    "    uVar1 = 1L << ((byte)(param_2 >> 2) & 0x3f);", 
    "    if ((uVar1 & 0x9a) == 0) {", 
    "      if ((uVar1 & 100) == 0) {", 
    "        uVar2 = *(undefined4 *)(param_1 + 0x23e8);", 
    "        uart_update_irq();", 
    "        qemu_chr_accept_input(*(undefined8 *)(param_1 + 0x23d8));", 
    "      }", 
    "      else {", 
    "        uVar2 = *(undefined4 *)(param_1 + 0x23e8 + (param_2 >> 2) * 4);", 
    "      }", 
    "    }", 
    "    else {", 
    "      error_report(\"lm32_uart: read access to write only register 0x%016lx\",", 
    "                   param_2 & 0xfffffffffffffffc);", 
    "      uVar2 = 0;", 
    "    }", 
    "  }", 
    "  else {", 
    "    error_report(\"lm32_uart: read access to unknown register 0x%016lx\",param_2 & 0xfffffffffffffffc)", 
    "    ;", 
    "    uVar2 = 0;", 
    "  }", 
    "  return uVar2;", 
    "}"
  ]
}