{
    "pseudo_code": [
        "void __cdecl virtio_pci_realize(PCIDevice *pci_dev, Error **errp)",
        "{",
        "  __int64 v2; // rax",
        "  bool v3; // al",
        "  uint64_t v4; // rdx",
        "  __int64 v5; // rcx",
        "  int v6; // edx",
        "  bool pcie_port; // [rsp+1Bh] [rbp-15h]",
        "  int pos; // [rsp+1Ch] [rbp-14h]",
        "  VirtIOPCIProxy *proxy; // [rsp+20h] [rbp-10h]",
        "  VirtioPCIClass *k; // [rsp+28h] [rbp-8h]",
        "",
        "  proxy = (VirtIOPCIProxy *)object_dynamic_cast_assert(",
        "                              pci_dev,",
        "                              \"virtio-pci\",",
        "                              \"hw/virtio/virtio-pci.c\",",
        "                              1722LL,",
        "                              \"virtio_pci_realize\");",
        "  v2 = object_get_class(pci_dev);",
        "  k = (VirtioPCIClass *)object_class_dynamic_cast_assert(",
        "                          v2,",
        "                          \"virtio-pci\",",
        "                          \"hw/virtio/virtio-pci.c\",",
        "                          1723LL,",
        "                          \"virtio_pci_realize\");",
        "  v3 = (unsigned __int8)pci_bus_is_express(pci_dev->bus) && (unsigned __int8)pci_bus_is_root(pci_dev->bus) != 1;",
        "  pcie_port = v3;",
        "  proxy->legacy_io_bar = 0;",
        "  proxy->msix_bar = 1;",
        "  proxy->modern_io_bar = 2;",
        "  proxy->modern_mem_bar = 4;",
        "  proxy->common.offset = 0;",
        "  proxy->common.size = 4096;",
        "  proxy->common.type = 1;",
        "  proxy->isr.offset = 4096;",
        "  proxy->isr.size = 4096;",
        "  proxy->isr.type = 3;",
        "  proxy->device.offset = 0x2000;",
        "  proxy->device.size = 4096;",
        "  proxy->device.type = 4;",
        "  proxy->notify.offset = 12288;",
        "  proxy->notify.size = virtio_pci_queue_mem_mult(proxy) << 10;",
        "  proxy->notify.type = 2;",
        "  proxy->notify_pio.offset = 0;",
        "  proxy->notify_pio.size = 4;",
        "  proxy->notify_pio.type = 2;",
        "  v4 = pow2ceil(proxy->notify.offset + proxy->notify.size);",
        "  memory_region_init(&proxy->modern_bar, proxy, \"virtio-pci\", v4);",
        "  v5 = memory_region_size(&proxy->modern_bar);",
        "  memory_region_init_alias(&proxy->modern_cfg, proxy, \"virtio-pci-cfg\", &proxy->modern_bar, 0LL, v5);",
        "  address_space_init(&proxy->modern_as, &proxy->modern_cfg, \"virtio-pci-cfg-as\");",
        "  if ( proxy->disable_legacy == OnOffAuto::ON_OFF_AUTO_AUTO )",
        "  {",
        "    if ( pcie_port )",
        "      v6 = 1;",
        "    else",
        "      v6 = 2;",
        "    proxy->disable_legacy = v6;",
        "  }",
        "  if ( pcie_port && pci_is_express(pci_dev) )",
        "  {",
        "    if ( (int)pcie_endpoint_cap_init(pci_dev, 0LL) <= 0 )",
        "      _assert_fail(\"pos > 0\", \"hw/virtio/virtio-pci.c\", 0x6F7u, \"virtio_pci_realize\");",
        "    pos = pci_add_capability(pci_dev, 1LL, 0LL, 8LL);",
        "    if ( pos <= 0 )",
        "      _assert_fail(\"pos > 0\", \"hw/virtio/virtio-pci.c\", 0x6FAu, \"virtio_pci_realize\");",
        "    pci_set_word(&pci_dev->config[pos + 2], 3u);",
        "  }",
        "  else",
        "  {",
        "    pci_dev->cap_present &= ~4u;",
        "  }",
        "  virtio_pci_bus_new(&proxy->bus, 0x68uLL, proxy);",
        "  if ( k->realize )",
        "    k->realize(proxy, errp);",
        "}"
    ]
}