    "pseudo_code": [
        "void __cdecl hmp_info_memdev(Monitor *mon, const QDict *qdict)",
        "{",
        "  uint16List **p_host_nodes; // rbx",
        "  __int64 visitor; // rax",
        "  const char *v4; // rax",
        "  const char *v5; // rax",
        "  const char *v6; // rax",
        "  int i; // [rsp+1Ch] [rbp-44h]",
        "  Error *err; // [rsp+20h] [rbp-40h] BYREF",
        "  MemdevList *m; // [rsp+28h] [rbp-38h]",
        "  MemdevList *memdev_list; // [rsp+30h] [rbp-30h]",
        "  StringOutputVisitor *ov; // [rsp+38h] [rbp-28h]",
        "  char *str; // [rsp+40h] [rbp-20h]",
        "  unsigned __int64 v13; // [rsp+48h] [rbp-18h]",
        "",
        "  v13 = __readfsqword(0x28u);",
        "  err = 0LL;",
        "  memdev_list = (MemdevList *)qmp_query_memdev(&err);",
        "  m = memdev_list;",
        "  i = 0;",
        "  while ( m )",
        "  {",
        "    ov = (StringOutputVisitor *)string_output_visitor_new(0LL);",
        "    p_host_nodes = &m->value->host_nodes;",
        "    visitor = string_output_get_visitor(ov);",
        "    visit_type_uint16List(visitor, 0LL, p_host_nodes, 0LL);",
        "    monitor_printf(mon, \"memory backend: %d\\n\", i);",
        "    monitor_printf(mon, \"  size:  %ld\\n\", m->value->size);",
        "    if ( m->value->merge )",
        "      v4 = \"true\";",
        "    else",
        "      v4 = \"false\";",
        "    monitor_printf(mon, \"  merge: %s\\n\", v4);",
        "    if ( m->value->dump )",
        "      v5 = \"true\";",
        "    else",
        "      v5 = \"false\";",
        "    monitor_printf(mon, \"  dump: %s\\n\", v5);",
        "    if ( m->value->prealloc )",
        "      v6 = \"true\";",
        "    else",
        "      v6 = \"false\";",
        "    monitor_printf(mon, \"  prealloc: %s\\n\", v6);",
        "    monitor_printf(mon, \"  policy: %s\\n\", *((const char **)&HostMemPolicy_lookup + (unsigned int)m->value->policy));",
        "    str = (char *)string_output_get_string(ov);",
        "    monitor_printf(mon, \"  host nodes: %s\\n\", str);",
        "    g_free(str);",
        "    string_output_visitor_cleanup(ov);",
        "    m = m->next;",
        "    ++i;",
        "  }",
        "  monitor_printf(mon, \"\\n\");",
        "  qapi_free_MemdevList(memdev_list);",
        "}"
    ]
