{
    "pseudo_code": [
        "__int64 __fastcall uart_read(__int64 a1, unsigned __int64 a2)",
        "{",
        "  unsigned __int64 v2; // rcx",
        "  int v3; // eax",
        "  unsigned int v4; // ebp",
        "  int v5; // eax",
        "  _BOOL8 v6; // rsi",
        "  int v8; // edx",
        "",
        "  v2 = a2 >> 2;",
        "  if ( a2 > 0x1F )",
        "  {",
        "    error_report(\"lm32_uart: read access to unknown register 0x%016lx\", a2 & 0xFFFFFFFFFFFFFFFCLL);",
        "    return 0LL;",
        "  }",
        "  else if ( ((1LL << v2) & 0x9A) != 0 )",
        "  {",
        "    error_report(\"lm32_uart: read access to write only register 0x%016lx\", a2 & 0xFFFFFFFFFFFFFFFCLL);",
        "    return 0LL;",
        "  }",
        "  else if ( ((1LL << v2) & 0x64) != 0 )",
        "  {",
        "    return *(unsigned int *)(a1 + 4 * v2 + 9192);",
        "  }",
        "  else",
        "  {",
        "    v3 = *(_DWORD *)(a1 + 9212);",
        "    v4 = *(_DWORD *)(a1 + 9192);",
        "    *(_DWORD *)(a1 + 9212) = v3 & 0xFFFFFFFE;",
        "    if ( (v3 & 0x1E) != 0 && (*(_BYTE *)(a1 + 9196) & 4) != 0 )",
        "    {",
        "      v5 = 6;",
        "      v6 = 1LL;",
        "    }",
        "    else if ( (v3 & 0x20) != 0 && (*(_BYTE *)(a1 + 9196) & 2) != 0 )",
        "    {",
        "      v5 = 2;",
        "      v6 = 1LL;",
        "    }",
        "    else if ( (*(_BYTE *)(a1 + 9216) & 0xF) != 0 )",
        "    {",
        "      v8 = *(_DWORD *)(a1 + 9196) & 8;",
        "      v5 = v8 == 0;",
        "      v6 = v8 != 0;",
        "    }",
        "    else",
        "    {",
        "      v5 = 1;",
        "      v6 = 0LL;",
        "    }",
        "    *(_DWORD *)(a1 + 9200) = v5;",
        "    qemu_set_irq(*(_QWORD *)(a1 + 9184), v6);",
        "    qemu_chr_accept_input(*(_QWORD *)(a1 + 9176));",
        "    return v4;",
        "  }",
        "}"
    ]
}