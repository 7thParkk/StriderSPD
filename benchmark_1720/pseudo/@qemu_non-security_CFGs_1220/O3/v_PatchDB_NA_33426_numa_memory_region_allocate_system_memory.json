{
    "pseudo_code": [
        "__int64 __fastcall memory_region_allocate_system_memory(__int64 a1, __int64 a2, __int64 a3, __int64 a4)",
        "{",
        "  __int64 v5; // r12",
        "  __int64 *v6; // rbx",
        "  __int64 v7; // r15",
        "  __int64 v8; // r13",
        "  __int64 memory; // rbp",
        "  __int64 v10; // rsi",
        "  const char *canonical_path_component; // rax",
        "  unsigned __int64 v12; // [rsp+18h] [rbp-40h]",
        "",
        "  v12 = __readfsqword(0x28u);",
        "  if ( *(_DWORD *)nb_numa_nodes && have_memdevs )",
        "  {",
        "    v5 = 0LL;",
        "    memory_region_init(a1, a2);",
        "    v6 = numa_info;",
        "    do",
        "    {",
        "      v7 = v6[5];",
        "      v8 = *v6;",
        "      if ( v7 )",
        "      {",
        "        memory = host_memory_backend_get_memory(v6[5], &error_fatal);",
        "        if ( (unsigned __int8)memory_region_is_mapped(memory) )",
        "        {",
        "          canonical_path_component = (const char *)object_get_canonical_path_component(v7);",
        "          error_report(",
        "            \"memory backend %s is used multiple times. Each -numa option must use a different memdev value.\",",
        "            canonical_path_component);",
        "          exit(1);",
        "        }",
        "        v10 = v5;",
        "        v5 += v8;",
        "        memory_region_add_subregion(a1, v10, memory);",
        "        vmstate_register_ram_global(memory);",
        "      }",
        "      v6 += 8;",
        "    }",
        "    while ( v6 != &numa_info[1024] );",
        "    return v12 - __readfsqword(0x28u);",
        "  }",
        "  else",
        "  {",
        "    if ( mem_path )",
        "      memory_region_init_ram_from_file(a1, a2, a3, a4, 0LL);",
        "    else",
        "      memory_region_init_ram(a1, a2, a3, a4, &error_fatal);",
        "    return vmstate_register_ram_global(a1);",
        "  }",
        "}"
    ]
}