{
    "pseudo_code": [
        "unsigned __int64 __fastcall memory_region_allocate_system_memory(__int64 a1, __int64 a2, __int64 a3, __int64 a4)",
        "{",
        "  unsigned __int64 result; // rax",
        "  int i; // [rsp+24h] [rbp-2Ch]",
        "  __int64 v6; // [rsp+28h] [rbp-28h]",
        "  unsigned __int64 v7; // [rsp+30h] [rbp-20h]",
        "  unsigned __int64 v8; // [rsp+38h] [rbp-18h]",
        "  __int64 memory; // [rsp+40h] [rbp-10h]",
        "  const char *canonical_path_component; // [rsp+48h] [rbp-8h]",
        "",
        "  v6 = 0LL;",
        "  if ( !nb_numa_nodes[0] || !have_memdevs )",
        "    return allocate_system_memory_nonnuma(a1, a2, a3, a4);",
        "  result = memory_region_init(a1, a2, a3, a4);",
        "  for ( i = 0; i <= 127; ++i )",
        "  {",
        "    v7 = numa_info[8 * (__int64)i];",
        "    result = numa_info[8 * (__int64)i + 5];",
        "    v8 = result;",
        "    if ( result )",
        "    {",
        "      memory = host_memory_backend_get_memory(result, &error_fatal);",
        "      if ( (unsigned __int8)memory_region_is_mapped(memory) )",
        "      {",
        "        canonical_path_component = (const char *)object_get_canonical_path_component(v8);",
        "        error_report(",
        "          \"memory backend %s is used multiple times. Each -numa option must use a different memdev value.\",",
        "          canonical_path_component);",
        "        exit(1);",
        "      }",
        "      host_memory_backend_set_mapped(v8, 1LL);",
        "      memory_region_add_subregion(a1, v6, memory);",
        "      vmstate_register_ram_global(memory);",
        "      result = v7;",
        "      v6 += v7;",
        "    }",
        "  }",
        "  return result;",
        "}"
    ]
}