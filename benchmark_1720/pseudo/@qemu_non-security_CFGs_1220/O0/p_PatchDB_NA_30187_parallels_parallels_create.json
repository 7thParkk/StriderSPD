{
    "pseudo_code": [
        "int __cdecl parallels_create(const char *filename, QemuOpts *opts, Error **errp)",
        "{",
        "  int ret; // [rsp+24h] [rbp-27Ch]",
        "  int reta; // [rsp+24h] [rbp-27Ch]",
        "  uint32_t bat_entries; // [rsp+28h] [rbp-278h]",
        "  uint32_t bat_sectors; // [rsp+2Ch] [rbp-274h]",
        "  Error *local_err; // [rsp+30h] [rbp-270h] BYREF",
        "  BlockDriverState *file; // [rsp+38h] [rbp-268h] BYREF",
        "  int64_t total_size; // [rsp+40h] [rbp-260h]",
        "  int64_t cl_size; // [rsp+48h] [rbp-258h]",
        "  ParallelsHeader header; // [rsp+50h] [rbp-250h] BYREF",
        "  uint8_t tmp[512]; // [rsp+90h] [rbp-210h] BYREF",
        "  unsigned __int64 v15; // [rsp+298h] [rbp-8h]",
        "",
        "  v15 = __readfsqword(0x28u);",
        "  local_err = 0LL;",
        "  total_size = (qemu_opt_get_size_del(opts, \"size\", 0LL) + 511) & 0xFFFFFFFFFFFFFE00LL;",
        "  cl_size = (qemu_opt_get_size_del(opts, \"cluster_size\", 0x100000LL) + 511) & 0xFFFFFFFFFFFFFE00LL;",
        "  ret = bdrv_create_file(filename, opts, &local_err);",
        "  if ( ret < 0 || (file = 0LL, ret = bdrv_open(&file, filename, 0LL, 0LL, 32770LL, 0LL, &local_err), ret < 0) )",
        "  {",
        "    error_propagate(errp, local_err);",
        "    return ret;",
        "  }",
        "  else",
        "  {",
        "    reta = bdrv_truncate(file, 0LL);",
        "    if ( reta < 0 )",
        "      goto exit;",
        "    bat_entries = (total_size + cl_size - 1) / cl_size;",
        "    bat_sectors = (cl_size * (unsigned int)((4 * ((unsigned __int64)bat_entries + 16) + cl_size - 1) / cl_size)) >> 9;",
        "    memset(&header, 0, sizeof(header));",
        "    qmemcpy(&header, \"WithouFreSpacExt\", 16);",
        "    header.version = cpu_to_le32(2u);",
        "    header.heads = cpu_to_le32(0x10u);",
        "    header.cylinders = cpu_to_le32((unsigned __int64)total_size >> 18);",
        "    header.tracks = cpu_to_le32(cl_size >> 9);",
        "    header.bat_entries = cpu_to_le32(bat_entries);",
        "    header.nb_sectors = cpu_to_le64((unsigned __int64)(total_size + 511) >> 9);",
        "    header.data_off = cpu_to_le32(bat_sectors);",
        "    memset(tmp, 0, sizeof(tmp));",
        "    *(ParallelsHeader *)tmp = header;",
        "    reta = bdrv_pwrite(file, 0LL, tmp, 512LL);",
        "    if ( reta < 0 || (reta = bdrv_write_zeroes(file, 1LL, bat_sectors - 1, 0LL), reta < 0) )",
        "exit:",
        "      error_set_errno(errp, (unsigned int)-reta, 0LL, \"Failed to create Parallels image\");",
        "    else",
        "      reta = 0;",
        "    bdrv_unref(file);",
        "    return reta;",
        "  }",
        "}"
    ]
}