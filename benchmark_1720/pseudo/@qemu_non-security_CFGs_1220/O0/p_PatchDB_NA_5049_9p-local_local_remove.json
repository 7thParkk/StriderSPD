{
    "pseudo_code": [
        "int __cdecl local_remove(FsContext *ctx, const char *path)",
        "{",
        "  int flags; // [rsp+14h] [rbp-BCh]",
        "  int err; // [rsp+18h] [rbp-B8h]",
        "  int dirfd; // [rsp+1Ch] [rbp-B4h]",
        "  char *dirpath; // [rsp+20h] [rbp-B0h]",
        "  char *name; // [rsp+28h] [rbp-A8h]",
        "  stat stbuf; // [rsp+30h] [rbp-A0h] BYREF",
        "  unsigned __int64 v9; // [rsp+C8h] [rbp-8h]",
        "",
        "  v9 = __readfsqword(0x28u);",
        "  dirpath = (char *)g_path_get_dirname(path);",
        "  name = (char *)g_path_get_basename(path);",
        "  flags = 0;",
        "  err = -1;",
        "  dirfd = local_opendir_nofollow(ctx, dirpath);",
        "  if ( dirfd != -1 )",
        "  {",
        "    if ( fstatat64(dirfd, name, (struct stat64 *)&stbuf, 256) >= 0 )",
        "    {",
        "      if ( (stbuf.st_mode & 0xF000) == 0x4000 )",
        "        flags = 512;",
        "      err = local_unlinkat_common(ctx, dirfd, name, flags);",
        "    }",
        "    close_preserve_errno(dirfd);",
        "  }",
        "  g_free(name);",
        "  g_free(dirpath);",
        "  return err;",
        "}"
    ]
}