{
    "pseudo_code": [
        "__int64 __fastcall throttle_is_valid(double *a1, __int64 a2)",
        "{",
        "  bool v2; // al",
        "  bool v3; // al",
        "  bool v4; // al",
        "  bool v5; // al",
        "  bool v7; // [rsp+18h] [rbp-8h]",
        "  bool v8; // [rsp+19h] [rbp-7h]",
        "  bool v9; // [rsp+1Ah] [rbp-6h]",
        "  int i; // [rsp+1Ch] [rbp-4h]",
        "",
        "  v2 = *a1 != 0.0 && (a1[5] != 0.0 || a1[10] != 0.0);",
        "  v7 = v2;",
        "  v3 = a1[15] != 0.0 && (a1[20] != 0.0 || a1[25] != 0.0);",
        "  v8 = v3;",
        "  v4 = a1[1] != 0.0 && (a1[6] != 0.0 || a1[11] != 0.0);",
        "  v9 = v4;",
        "  v5 = a1[16] != 0.0 && (a1[21] != 0.0 || a1[26] != 0.0);",
        "  if ( v7 || v8 || v9 || v5 )",
        "  {",
        "    error_setg_internal(",
        "      a2,",
        "      file,",
        "      313LL,",
        "      \"throttle_is_valid\",",
        "      \"bps/iops/max total values and read/write values cannot be used at the same time\");",
        "    return 0LL;",
        "  }",
        "  else",
        "  {",
        "    for ( i = 0; i <= 5; ++i )",
        "    {",
        "      if ( a1[5 * i] < 0.0 || a1[5 * i + 1] < 0.0 || a1[5 * i] > 1.0e15 || a1[5 * i + 1] > 1.0e15 )",
        "      {",
        "        error_setg_internal(",
        "          a2,",
        "          file,",
        "          323LL,",
        "          \"throttle_is_valid\",",
        "          \"bps/iops/max values must be within [0, %lld]\",",
        "          1000000000000000LL);",
        "        return 0LL;",
        "      }",
        "      if ( !LODWORD(a1[5 * i + 4]) )",
        "      {",
        "        error_setg_internal(a2, file, 329LL, \"throttle_is_valid\", \"the burst length cannot be 0\");",
        "        return 0LL;",
        "      }",
        "      if ( LODWORD(a1[5 * i + 4]) > 1 && a1[5 * i + 1] == 0.0 )",
        "      {",
        "        error_setg_internal(a2, file, 334LL, \"throttle_is_valid\", \"burst length set without burst rate\");",
        "        return 0LL;",
        "      }",
        "      if ( a1[5 * i + 1] != 0.0 && a1[5 * i] == 0.0 )",
        "      {",
        "        error_setg_internal(",
        "          a2,",
        "          file,",
        "          339LL,",
        "          \"throttle_is_valid\",",
        "          \"bps_max/iops_max require corresponding bps/iops values\");",
        "        return 0LL;",
        "      }",
        "    }",
        "    return 1LL;",
        "  }",
        "}"
    ]
}