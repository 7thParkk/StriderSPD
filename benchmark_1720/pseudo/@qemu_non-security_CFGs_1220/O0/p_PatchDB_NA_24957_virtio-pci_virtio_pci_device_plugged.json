{
    "pseudo_code": [
        "void __cdecl virtio_pci_device_plugged(DeviceState *d, Error **errp)",
        "{",
        "  uint16_t word; // ax",
        "  uint16_t vdev_id; // ax",
        "  __int16 v4; // ax",
        "  VirtIODevice *v5; // rdx",
        "  VirtIODevice *v6; // rdx",
        "  int v7; // ebx",
        "  Error **errpa; // [rsp+0h] [rbp-B0h]",
        "  Error **errpb; // [rsp+0h] [rbp-B0h]",
        "  Error **errpc; // [rsp+0h] [rbp-B0h]",
        "  Error **errpd; // [rsp+0h] [rbp-B0h]",
        "  DeviceState *da; // [rsp+8h] [rbp-A8h]",
        "  DeviceState *db; // [rsp+8h] [rbp-A8h]",
        "  DeviceState *dc; // [rsp+8h] [rbp-A8h]",
        "  DeviceState *dd; // [rsp+8h] [rbp-A8h]",
        "  bool legacy; // [rsp+1Eh] [rbp-92h]",
        "  bool modern; // [rsp+1Fh] [rbp-91h]",
        "  uint32_t size; // [rsp+20h] [rbp-90h]",
        "  VirtIOPCIProxy *proxy; // [rsp+30h] [rbp-80h]",
        "  VirtioBusState *bus; // [rsp+38h] [rbp-78h]",
        "  VirtIODevice *vdev; // [rsp+40h] [rbp-70h]",
        "  uint8_t *config; // [rsp+48h] [rbp-68h]",
        "  virtio_pci_cap common; // [rsp+50h] [rbp-60h] BYREF",
        "  virtio_pci_cap isr; // [rsp+60h] [rbp-50h] BYREF",
        "  virtio_pci_cap device; // [rsp+70h] [rbp-40h] BYREF",
        "  virtio_pci_notify_cap notify; // [rsp+80h] [rbp-30h] BYREF",
        "  unsigned __int64 v27; // [rsp+98h] [rbp-18h]",
        "",
        "  da = d;",
        "  errpa = errp;",
        "  v27 = __readfsqword(0x28u);",
        "  proxy = (VirtIOPCIProxy *)object_dynamic_cast_assert(",
        "                              d,",
        "                              \"virtio-pci\",",
        "                              \"hw/virtio/virtio-pci.c\",",
        "                              1215LL,",
        "                              \"virtio_pci_device_plugged\");",
        "  bus = &proxy->bus;",
        "  legacy = (proxy->flags & 4) == 0;",
        "  modern = (proxy->flags & 8) == 0;",
        "  vdev = virtio_bus_get_device(&proxy->bus);",
        "  config = proxy->pci_dev.config;",
        "  if ( proxy->class_code )",
        "    pci_config_set_class(config, proxy->class_code);",
        "  if ( legacy )",
        "  {",
        "    word = pci_get_word(config);",
        "    pci_set_word(config + 44, word);",
        "    vdev_id = virtio_bus_get_vdev_id(bus);",
        "    pci_set_word(config + 46, vdev_id);",
        "  }",
        "  else",
        "  {",
        "    pci_set_word(config, 0x1AF4u);",
        "    v4 = virtio_bus_get_vdev_id(bus);",
        "    pci_set_word(config + 2, v4 + 4160);",
        "    pci_config_set_revision(config, 1u);",
        "  }",
        "  config[61] = 1;",
        "  if ( modern )",
        "  {",
        "    *(_QWORD *)&common.cap_vndr = 0x401100000LL;",
        "    common.offset = cpu_to_le32(0);",
        "    common.length = cpu_to_le32(0x1000u);",
        "    *(_QWORD *)&isr.cap_vndr = 0x403100000LL;",
        "    isr.offset = cpu_to_le32(0x1000u);",
        "    isr.length = cpu_to_le32(0x1000u);",
        "    *(_QWORD *)&device.cap_vndr = 0x404100000LL;",
        "    device.offset = cpu_to_le32(0x2000u);",
        "    device.length = cpu_to_le32(0x1000u);",
        "    *(_QWORD *)&notify.cap.cap_vndr = 0x402140000LL;",
        "    notify.cap.offset = cpu_to_le32(0x3000u);",
        "    notify.cap.length = cpu_to_le32(0x400000u);",
        "    notify.notify_off_multiplier = cpu_to_le32(0x1000u);",
        "    virtio_pci_add_mem_cap(proxy, &common);",
        "    virtio_pci_add_mem_cap(proxy, &isr);",
        "    virtio_pci_add_mem_cap(proxy, &device);",
        "    virtio_pci_add_mem_cap(proxy, &notify.cap);",
        "    virtio_add_feature((uint64_t *)vdev + 18, 0x20u);",
        "    memory_region_init(&proxy->modern_bar, proxy, \"virtio-pci\", 0x800000LL);",
        "    memory_region_init_io(&proxy->common, proxy, &common_ops_31, proxy, \"virtio-pci-common\", 4096LL, errp, d);",
        "    memory_region_add_subregion(&proxy->modern_bar, 0LL, &proxy->common);",
        "    memory_region_init_io(&proxy->isr, proxy, &isr_ops_30, proxy, \"virtio-pci-isr\", 4096LL, errpb, db);",
        "    memory_region_add_subregion(&proxy->modern_bar, 4096LL, &proxy->isr);",
        "    v5 = virtio_bus_get_device(&proxy->bus);",
        "    memory_region_init_io(&proxy->device, proxy, &device_ops_29, v5, \"virtio-pci-device\", 4096LL, errpc, dc);",
        "    memory_region_add_subregion(&proxy->modern_bar, 0x2000LL, &proxy->device);",
        "    v6 = virtio_bus_get_device(&proxy->bus);",
        "    memory_region_init_io(&proxy->notify, proxy, &notify_ops_28, v6, \"virtio-pci-notify\", 0x400000LL, errpd, dd);",
        "    memory_region_add_subregion(&proxy->modern_bar, 12288LL, &proxy->notify);",
        "    pci_register_bar(proxy, 4LL, 12LL, &proxy->modern_bar);",
        "  }",
        "  if ( proxy->nvectors && (unsigned int)msix_init_exclusive_bar(proxy, (unsigned __int16)proxy->nvectors, 1LL) )",
        "  {",
        "    error_report(\"unable to init msix vectors to %u\", proxy->nvectors);",
        "    proxy->nvectors = 0;",
        "  }",
        "  proxy->pci_dev.config_write = (PCIConfigWriteFunc *)virtio_write_config;",
        "  if ( legacy )",
        "  {",
        "    if ( (unsigned int)msix_present(proxy) )",
        "      v7 = 24;",
        "    else",
        "      v7 = 20;",
        "    size = v7 + virtio_bus_get_vdev_config_len(bus);",
        "    if ( (size & (size - 1)) != 0 )",
        "      size = 1 << qemu_fls(size);",
        "    memory_region_init_io(&proxy->bar, proxy, &virtio_pci_config_ops, proxy, \"virtio-pci\", size, errpa, da);",
        "    pci_register_bar(proxy, 0LL, 1LL, &proxy->bar);",
        "  }",
        "  if ( !(unsigned int)kvm_has_many_ioeventfds() )",
        "    proxy->flags &= ~2u;",
        "  virtio_add_feature((uint64_t *)vdev + 18, 0x1Eu);",
        "}"
    ]
}