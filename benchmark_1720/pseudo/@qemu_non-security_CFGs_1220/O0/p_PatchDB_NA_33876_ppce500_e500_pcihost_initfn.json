{
    "pseudo_code": [
        "int __cdecl e500_pcihost_initfn(SysBusDevice *dev)",
        "{",
        "  __int64 v1; // rbx",
        "  __int64 v2; // rax",
        "  int i; // [rsp+1Ch] [rbp-34h]",
        "  int ia; // [rsp+1Ch] [rbp-34h]",
        "  MemoryRegion *address_space_mem; // [rsp+20h] [rbp-30h]",
        "  PCIHostState *h; // [rsp+28h] [rbp-28h]",
        "  PPCE500PCIState *s; // [rsp+30h] [rbp-20h]",
        "  PCIBus *b; // [rsp+38h] [rbp-18h]",
        "",
        "  address_space_mem = (MemoryRegion *)get_system_memory();",
        "  h = (PCIHostState *)object_dynamic_cast_assert(",
        "                        dev,",
        "                        \"pci-host-bridge\",",
        "                        \"hw/pci-host/ppce500.c\",",
        "                        360LL,",
        "                        \"e500_pcihost_initfn\");",
        "  s = (PPCE500PCIState *)object_dynamic_cast_assert(",
        "                           dev,",
        "                           \"e500-pcihost\",",
        "                           \"hw/pci-host/ppce500.c\",",
        "                           361LL,",
        "                           \"e500_pcihost_initfn\");",
        "  for ( i = 0; (unsigned int)i <= 3; ++i )",
        "    sysbus_init_irq(dev, &s->irq[i]);",
        "  for ( ia = 0; ia <= 3; ++ia )",
        "    s->irq_num[ia] = s->first_pin_irq + ia;",
        "  memory_region_init(&s->pio, s, \"pci-pio\", 0x10000LL);",
        "  v1 = (unsigned __int8)(8 * s->first_slot);",
        "  v2 = object_dynamic_cast_assert(dev, \"device\", \"hw/pci-host/ppce500.c\", 373LL, \"e500_pcihost_initfn\");",
        "  b = (PCIBus *)pci_register_bus(",
        "                  v2,",
        "                  0LL,",
        "                  mpc85xx_pci_set_irq,",
        "                  mpc85xx_pci_map_irq,",
        "                  s,",
        "                  address_space_mem,",
        "                  &s->pio,",
        "                  v1,",
        "                  4LL,",
        "                  \"PCI\");",
        "  h->bus = b;",
        "  pci_create_simple(b, 0LL, \"e500-host-bridge\");",
        "  memory_region_init(&s->container, h, \"pci-container\", 4096LL);",
        "  memory_region_init_io(&h->conf_mem, h, &pci_host_conf_be_ops, h, \"pci-conf-idx\", 4LL);",
        "  memory_region_init_io(&h->data_mem, h, &pci_host_data_le_ops, h, \"pci-conf-data\", 4LL);",
        "  memory_region_init_io(&s->iomem, s, &e500_pci_reg_ops, s, \"pci.reg\", 1024LL);",
        "  memory_region_add_subregion(&s->container, 0LL, &h->conf_mem);",
        "  memory_region_add_subregion(&s->container, 4LL, &h->data_mem);",
        "  memory_region_add_subregion(&s->container, 3072LL, &s->iomem);",
        "  sysbus_init_mmio(dev, &s->container);",
        "  sysbus_init_mmio(dev, &s->pio);",
        "  pci_bus_set_route_irq_fn(b, e500_route_intx_pin_to_irq);",
        "  return 0;",
        "}"
    ]
}