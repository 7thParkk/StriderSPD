{
    "pseudo_code": [
        "bool __cdecl aio_poll(AioContext *ctx, bool blocking)",
        "{",
        "  __int64 v2; // rax",
        "  char progress; // [rsp+17h] [rbp-69h]",
        "  unsigned int i; // [rsp+18h] [rbp-68h]",
        "  int ret; // [rsp+1Ch] [rbp-64h]",
        "  AioHandler *node; // [rsp+20h] [rbp-60h]",
        "  int64_t timeout; // [rsp+28h] [rbp-58h]",
        "  AioHandler epoll_handler; // [rsp+30h] [rbp-50h] BYREF",
        "  unsigned __int64 v10; // [rsp+78h] [rbp-8h]",
        "",
        "  v10 = __readfsqword(0x28u);",
        "  aio_context_acquire(ctx);",
        "  progress = 0;",
        "  if ( blocking )",
        "    _InterlockedAdd((volatile signed __int32 *)&ctx->notify_me, 2u);",
        "  ++ctx->walking_handlers;",
        "  if ( npfd )",
        "    _assert_fail(\"npfd == 0\", \"aio-posix.c\", 0x1B0u, \"aio_poll\");",
        "  if ( !aio_epoll_enabled(ctx) )",
        "  {",
        "    for ( node = ctx->aio_handlers.lh_first; node; node = node->node.le_next )",
        "    {",
        "      if ( !node->deleted && node->pfd.events && aio_node_check(ctx, node->is_external) )",
        "        add_pollfd(node);",
        "    }",
        "  }",
        "  if ( blocking )",
        "    v2 = aio_compute_timeout(ctx);",
        "  else",
        "    v2 = 0LL;",
        "  timeout = v2;",
        "  if ( v2 )",
        "    aio_context_release(ctx);",
        "  if ( aio_epoll_check_poll(ctx, pollfds, npfd, timeout) )",
        "  {",
        "    epoll_handler.pfd.fd = ctx->epollfd;",
        "    epoll_handler.pfd.events = 29;",
        "    npfd = 0;",
        "    add_pollfd(&epoll_handler);",
        "    ret = aio_epoll(ctx, pollfds, npfd, timeout);",
        "  }",
        "  else",
        "  {",
        "    ret = qemu_poll_ns(pollfds, npfd, timeout);",
        "  }",
        "  if ( blocking )",
        "    _InterlockedSub((volatile signed __int32 *)&ctx->notify_me, 2u);",
        "  if ( timeout )",
        "    aio_context_acquire(ctx);",
        "  aio_notify_accept(ctx);",
        "  if ( ret > 0 )",
        "  {",
        "    for ( i = 0; i < npfd; ++i )",
        "      nodes[i]->pfd.revents = pollfds[i].revents;",
        "  }",
        "  npfd = 0;",
        "  --ctx->walking_handlers;",
        "  if ( aio_dispatch(ctx, ret > 0) )",
        "    progress = 1;",
        "  aio_context_release(ctx);",
        "  return progress;",
        "}"
    ]
}