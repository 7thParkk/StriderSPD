{
    "pseudo_code": [
        "int __cdecl blkdebug_open(BlockDriverState *bs, QDict *options, int flags, Error **errp)",
        "{",
        "  int ret; // [rsp+2Ch] [rbp-34h]",
        "  Error *local_err; // [rsp+30h] [rbp-30h] BYREF",
        "  BDRVBlkdebugState *s; // [rsp+38h] [rbp-28h]",
        "  QemuOpts *opts; // [rsp+40h] [rbp-20h]",
        "  const char *config; // [rsp+48h] [rbp-18h]",
        "  const char *filename; // [rsp+50h] [rbp-10h]",
        "  unsigned __int64 v13; // [rsp+58h] [rbp-8h]",
        "",
        "  v13 = __readfsqword(0x28u);",
        "  s = (BDRVBlkdebugState *)bs->opaque;",
        "  local_err = 0LL;",
        "  opts = (QemuOpts *)qemu_opts_create(&runtime_opts, 0LL, 0LL, &error_abort);",
        "  qemu_opts_absorb_qdict(opts, options, &local_err);",
        "  if ( (unsigned __int8)error_is_set(&local_err) )",
        "  {",
        "    error_propagate(errp, local_err);",
        "    ret = -22;",
        "  }",
        "  else",
        "  {",
        "    config = (const char *)qemu_opt_get(opts, \"config\");",
        "    ret = read_config(s, config, errp);",
        "    if ( !ret )",
        "    {",
        "      s->state = 1;",
        "      filename = (const char *)qemu_opt_get(opts, \"x-image\");",
        "      if ( filename )",
        "      {",
        "        ret = bdrv_file_open(&bs->file, filename, 0LL, (unsigned int)flags, &local_err);",
        "        if ( ret >= 0 )",
        "          ret = 0;",
        "        else",
        "          error_propagate(errp, local_err);",
        "      }",
        "      else",
        "      {",
        "        error_set(errp, 0LL, \"Could not retrieve image file name\");",
        "        ret = -22;",
        "      }",
        "    }",
        "  }",
        "  qemu_opts_del(opts);",
        "  return ret;",
        "}"
    ]
}