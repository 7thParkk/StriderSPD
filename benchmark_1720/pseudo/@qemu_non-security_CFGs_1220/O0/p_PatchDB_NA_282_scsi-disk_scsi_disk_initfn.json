{
    "pseudo_code": [
        "__int64 __fastcall scsi_disk_initfn(__int64 a1)",
        "{",
        "  _QWORD v2[2]; // [rsp+18h] [rbp-28h] BYREF",
        "  __int64 v3; // [rsp+28h] [rbp-18h]",
        "  unsigned __int64 v4; // [rsp+38h] [rbp-8h]",
        "",
        "  v4 = __readfsqword(0x28u);",
        "  v2[1] = a1;",
        "  v3 = a1;",
        "  if ( *(_QWORD *)(a1 + 120) && **(_QWORD **)(v3 + 120) )",
        "  {",
        "    *(_QWORD *)(v3 + 176) = **(_QWORD **)(v3 + 120);",
        "    if ( (unsigned int)bdrv_is_sg(*(_QWORD *)(v3 + 176)) )",
        "    {",
        "      qemu_error(\"scsi-disk: unwanted /dev/sg*\\n\");",
        "      return 0xFFFFFFFFLL;",
        "    }",
        "    else",
        "    {",
        "      if ( (unsigned int)bdrv_get_type_hint(*(_QWORD *)(v3 + 176)) == 1 )",
        "        *(_DWORD *)(v3 + 184) = 4;",
        "      else",
        "        *(_DWORD *)(v3 + 184) = 1;",
        "      *(_DWORD *)(v3 + 160) = *(_DWORD *)(v3 + 184) << 9;",
        "      *(_DWORD *)(v3 + 164) = 0;",
        "      bdrv_get_geometry(*(_QWORD *)(v3 + 176), v2);",
        "      v2[0] /= (unsigned __int64)*(int *)(v3 + 184);",
        "      if ( v2[0] )",
        "        --v2[0];",
        "      *(_QWORD *)(v3 + 192) = v2[0];",
        "      qemu_add_vm_change_state_handler(scsi_dma_restart_cb, v3);",
        "      return 0LL;",
        "    }",
        "  }",
        "  else",
        "  {",
        "    qemu_error(\"scsi-disk: drive property not set\\n\");",
        "    return 0xFFFFFFFFLL;",
        "  }",
        "}"
    ]
}