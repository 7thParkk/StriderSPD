{
    "pseudo_code": [
        "int __cdecl nbd_client_init(",
        "        BlockDriverState *bs,",
        "        QIOChannelSocket *sioc,",
        "        const char *export,",
        "        QCryptoTLSCreds *tlscreds,",
        "        const char *hostname,",
        "        Error **errp)",
        "{",
        "  __int64 v6; // rax",
        "  __int64 v7; // rdi",
        "  __int64 v9; // rax",
        "  AioContext *aio_context; // rdx",
        "  int ret; // [rsp+34h] [rbp-2Ch]",
        "  NbdClientSession *client; // [rsp+38h] [rbp-28h]",
        "",
        "  client = (NbdClientSession *)nbd_get_client_session(bs);",
        "  v6 = object_dynamic_cast_assert(sioc, \"qio-channel\", \"block/nbd-client.c\", 409LL, \"nbd_client_init\");",
        "  qio_channel_set_blocking(v6, 1LL, 0LL);",
        "  v7 = object_dynamic_cast_assert(sioc, \"qio-channel\", \"block/nbd-client.c\", 411LL, \"nbd_client_init\");",
        "  ret = nbd_receive_negotiate(v7, export, &client->nbdflags, tlscreds, hostname, &client->ioc, &client->size, errp);",
        "  if ( ret < 0 )",
        "    return ret;",
        "  qemu_co_mutex_init(&client->send_mutex);",
        "  qemu_co_mutex_init(&client->free_sema);",
        "  client->sioc = sioc;",
        "  object_ref(client->sioc);",
        "  if ( !client->ioc )",
        "  {",
        "    client->ioc = (QIOChannel *)object_dynamic_cast_assert(",
        "                                  sioc,",
        "                                  \"qio-channel\",",
        "                                  \"block/nbd-client.c\",",
        "                                  427LL,",
        "                                  \"nbd_client_init\");",
        "    object_ref(client->ioc);",
        "  }",
        "  v9 = object_dynamic_cast_assert(sioc, \"qio-channel\", \"block/nbd-client.c\", 433LL, \"nbd_client_init\");",
        "  qio_channel_set_blocking(v9, 0LL, 0LL);",
        "  aio_context = (AioContext *)bdrv_get_aio_context(bs);",
        "  nbd_client_attach_aio_context(bs, aio_context);",
        "  return 0;",
        "}"
    ]
}