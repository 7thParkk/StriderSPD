{
    "pseudo_code": [
        "uint32_t __cdecl virtio_net_get_features(VirtIODevice *vdev, uint32_t features)",
        "{",
        "  uint32_t v3; // ebx",
        "  __int64 vhost_net; // rax",
        "  uint32_t featuresa; // [rsp+4h] [rbp-2Ch] BYREF",
        "  VirtIODevice *vdeva; // [rsp+8h] [rbp-28h]",
        "  VirtIONet *n; // [rsp+10h] [rbp-20h]",
        "  NetClientState *nc; // [rsp+18h] [rbp-18h]",
        "",
        "  vdeva = vdev;",
        "  featuresa = features;",
        "  n = (VirtIONet *)object_dynamic_cast_assert(",
        "                     vdev,",
        "                     \"virtio-net-device\",",
        "                     \"hw/net/virtio-net.c\",",
        "                     446LL,",
        "                     \"virtio_net_get_features\");",
        "  nc = (NetClientState *)qemu_get_queue(*((_QWORD *)n + 29));",
        "  featuresa = *((_DWORD *)n + 68) | features;",
        "  virtio_add_feature(&featuresa, 5u);",
        "  if ( !peer_has_vnet_hdr(n) )",
        "  {",
        "    virtio_clear_feature(&featuresa, 0);",
        "    virtio_clear_feature(&featuresa, 0xBu);",
        "    virtio_clear_feature(&featuresa, 0xCu);",
        "    virtio_clear_feature(&featuresa, 0xDu);",
        "    virtio_clear_feature(&featuresa, 1u);",
        "    virtio_clear_feature(&featuresa, 7u);",
        "    virtio_clear_feature(&featuresa, 8u);",
        "    virtio_clear_feature(&featuresa, 9u);",
        "  }",
        "  if ( !peer_has_vnet_hdr(n) || !peer_has_ufo(n) )",
        "  {",
        "    virtio_clear_feature(&featuresa, 0xAu);",
        "    virtio_clear_feature(&featuresa, 0xEu);",
        "  }",
        "  if ( !get_vhost_net(nc->peer) )",
        "    return featuresa;",
        "  v3 = featuresa;",
        "  vhost_net = get_vhost_net(nc->peer);",
        "  return vhost_net_get_features(vhost_net, v3);",
        "}"
    ]
}