{
    "pseudo_code": [
        "uint32_t __cdecl gic_acknowledge_irq(GICState *s, int cpu)",
        "{",
        "  int v2; // eax",
        "  char v4; // al",
        "  char v5; // al",
        "  char v6; // al",
        "  uint32_t ret; // [rsp+18h] [rbp-18h]",
        "  int cm; // [rsp+1Ch] [rbp-14h]",
        "  int irq; // [rsp+20h] [rbp-10h]",
        "  __int16 src; // [rsp+24h] [rbp-Ch]",
        "",
        "  cm = 1 << cpu;",
        "  irq = s->current_pending[cpu];",
        "  if ( irq == 1023 )",
        "    return 1023;",
        "  v2 = s->current_pending[cpu] > 0x1Fu ? s->priority1[28][irq] : s->priority1[s->current_pending[cpu]][cpu];",
        "  if ( v2 >= s->running_priority[cpu] )",
        "    return 1023;",
        "  s->last_active[s->current_pending[cpu]][cpu] = s->running_irq[cpu];",
        "  if ( s->revision && s->revision != -1 )",
        "  {",
        "    if ( irq > 15 )",
        "    {",
        "      if ( s->irq_state[irq].model )",
        "        v6 = 0;",
        "      else",
        "        v6 = ~(_BYTE)cm;",
        "      s->irq_state[irq].pending &= v6;",
        "      ret = irq;",
        "    }",
        "    else",
        "    {",
        "      if ( !s->sgi_pending[irq][cpu] )",
        "        _assert_fail(\"s->sgi_pending[irq][cpu] != 0\", \"hw/intc/arm_gic.c\", 0xCCu, \"gic_acknowledge_irq\");",
        "      src = ctz32(s->sgi_pending[irq][cpu]);",
        "      s->sgi_pending[irq][cpu] &= ~(1 << src);",
        "      if ( !s->sgi_pending[irq][cpu] )",
        "      {",
        "        if ( s->irq_state[irq].model )",
        "          v5 = 0;",
        "        else",
        "          v5 = ~(_BYTE)cm;",
        "        s->irq_state[irq].pending &= v5;",
        "      }",
        "      ret = irq | (src << 10) & 0x1C00;",
        "    }",
        "  }",
        "  else",
        "  {",
        "    if ( s->irq_state[irq].model )",
        "      v4 = 0;",
        "    else",
        "      v4 = ~(_BYTE)cm;",
        "    s->irq_state[irq].pending &= v4;",
        "    ret = irq;",
        "  }",
        "  gic_set_running_irq(s, cpu, irq);",
        "  return ret;",
        "}"
    ]
}