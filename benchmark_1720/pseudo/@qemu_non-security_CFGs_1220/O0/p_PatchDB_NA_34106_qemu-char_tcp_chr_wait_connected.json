{
    "pseudo_code": [
        "int __cdecl tcp_chr_wait_connected(CharDriverState *chr, Error **errp)",
        "{",
        "  __int64 v2; // rax",
        "  QIOChannel *v3; // rcx",
        "  __int64 v4; // rdi",
        "  TCPCharDriver *s; // [rsp+10h] [rbp-10h]",
        "  QIOChannelSocket *sioc; // [rsp+18h] [rbp-8h]",
        "",
        "  s = (TCPCharDriver *)chr->opaque;",
        "  while ( !s->ioc )",
        "  {",
        "    if ( s->is_listen )",
        "    {",
        "      fprintf(stderr, \"QEMU waiting for connection on: %s\\n\", chr->filename);",
        "      v2 = object_dynamic_cast_assert(s->listen_ioc, \"qio-channel\", \"qemu-char.c\", 3185LL, \"tcp_chr_wait_connected\");",
        "      qio_channel_set_blocking(v2, 1LL, 0LL);",
        "      v3 = (QIOChannel *)object_dynamic_cast_assert(",
        "                           s->listen_ioc,",
        "                           \"qio-channel\",",
        "                           \"qemu-char.c\",",
        "                           3186LL,",
        "                           \"tcp_chr_wait_connected\");",
        "      tcp_chr_accept(v3, G_IO_IN, chr);",
        "      v4 = object_dynamic_cast_assert(s->listen_ioc, \"qio-channel\", \"qemu-char.c\", 3187LL, \"tcp_chr_wait_connected\");",
        "      qio_channel_set_blocking(v4, 0LL, 0LL);",
        "    }",
        "    else",
        "    {",
        "      sioc = (QIOChannelSocket *)qio_channel_socket_new();",
        "      if ( (int)qio_channel_socket_connect_sync(sioc, s->addr, errp) < 0 )",
        "      {",
        "        object_unref(sioc);",
        "        return -1;",
        "      }",
        "      tcp_chr_new_client(chr, sioc);",
        "      object_unref(sioc);",
        "    }",
        "  }",
        "  return 0;",
        "}"
    ]
}