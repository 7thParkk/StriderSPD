        "      vtd_set_long((IntelIOMMUState *)opaque, addr, val);",
        "      vtd_handle_fectl_write((IntelIOMMUState *)opaque);",
        "      break;",
        "    case 0x3CuLL:",
        "      if ( size != 4 )",
        "        _assert_fail(\"size == 4\", \"hw/i386/intel_iommu.c\", 0x6AAu, \"vtd_mem_write\");",
