{
    "pseudo_code": [
        "int __cdecl parallels_open(BlockDriverState *bs, QDict *options, int flags, Error **errp)",
        "{",
        "  __int64 v4; // rax",
        "  bool v5; // al",
        "  int i; // [rsp+20h] [rbp-60h]",
        "  int ret; // [rsp+24h] [rbp-5Ch]",
        "  BDRVParallelsState *s; // [rsp+28h] [rbp-58h]",
        "  ParallelsHeader ph; // [rsp+30h] [rbp-50h] BYREF",
        "  unsigned __int64 v12; // [rsp+78h] [rbp-8h]",
        "",
        "  v12 = __readfsqword(0x28u);",
        "  s = (BDRVParallelsState *)bs->opaque;",
        "  ret = bdrv_pread(bs->file, 0LL, &ph, 64LL);",
        "  if ( ret < 0 )",
        "    goto fail;",
        "  bs->total_sectors = le64_to_cpu(ph.nb_sectors);",
        "  if ( le32_to_cpu(ph.version) != 2 )",
        "    goto fail_format;",
        "  if ( !memcmp(&ph, \"WithoutFreeSpace\", 0x10uLL) )",
        "  {",
        "    s->off_multiplier = 1;",
        "    bs->total_sectors = (unsigned int)bs->total_sectors;",
        "    goto LABEL_7;",
        "  }",
        "  if ( memcmp(&ph, \"WithouFreSpacExt\", 0x10uLL) )",
        "  {",
        "fail_format:",
        "    error_set(errp, 0LL, \"Image not in Parallels format\");",
        "    ret = -22;",
        "    goto fail;",
        "  }",
        "  s->off_multiplier = le32_to_cpu(ph.tracks);",
        "LABEL_7:",
        "  s->tracks = le32_to_cpu(ph.tracks);",
        "  if ( !s->tracks )",
        "  {",
        "    error_set(errp, 0LL, \"Invalid image: Zero sectors per track\");",
        "    ret = -22;",
        "fail:",
        "    g_free(s->bat_bitmap);",
        "    return ret;",
        "  }",
        "  if ( s->tracks > 0x3FE00F )",
        "  {",
        "    error_set(errp, 0LL, \"Invalid image: Too big cluster\");",
        "    ret = -27;",
        "    goto fail;",
        "  }",
        "  s->bat_size = le32_to_cpu(ph.bat_entries);",
        "  if ( s->bat_size > 0x1FFFFFFF )",
        "  {",
        "    error_set(errp, 0LL, \"Catalog too large\");",
        "    ret = -27;",
        "    goto fail;",
        "  }",
        "  s->bat_bitmap = (uint32_t *)g_try_malloc_n(s->bat_size, 4LL);",
        "  if ( s->bat_size && !s->bat_bitmap )",
        "  {",
        "    ret = -12;",
        "    goto fail;",
        "  }",
        "  ret = bdrv_pread(bs->file, 64LL, s->bat_bitmap, 4 * s->bat_size);",
        "  if ( ret < 0 )",
        "    goto fail;",
        "  for ( i = 0; i < s->bat_size; ++i )",
        "    le32_to_cpus(&s->bat_bitmap[i]);",
        "  v5 = 0;",
        "  if ( (unsigned int)bdrv_has_zero_init(bs->file) )",
        "  {",
        "    v4 = bdrv_getlength(bs->file);",
        "    if ( !(unsigned int)bdrv_truncate(bs->file, v4) )",
        "      v5 = 1;",
        "  }",
        "  s->has_truncate = v5;",
        "  qemu_co_mutex_init(s);",
        "  return 0;",
        "}"
    ]
}