        "void __cdecl vtd_init(IntelIOMMUState *s)",
        "{",
        "  X86IOMMUState *x86_iommu; // [rsp+18h] [rbp-8h]",
        "",
        "  x86_iommu = (X86IOMMUState *)object_dynamic_cast_assert(s, \"x86-iommu\", \"hw/i386/intel_iommu.c\", 2003LL, \"vtd_init\");",
        "  memset(s->csr, 0, sizeof(s->csr));",
        "  memset(s->wmask, 0, sizeof(s->wmask));",
        "  memset(s->w1cmask, 0, sizeof(s->w1cmask));",
        "  memset(s->womask, 0, sizeof(s->womask));",
        "  s->iommu_ops.translate = (IOMMUTLBEntry (*)(MemoryRegion *, hwaddr, bool))vtd_iommu_translate;",
        "  s->iommu_ops.notify_started = (void (*)(MemoryRegion *))vtd_iommu_notify_started;",
        "  s->root = 0LL;",
        "  s->root_extended = 0;",
        "  s->dmar_enabled = 0;",
        "  s->iq_head = 0;",
        "  s->iq_tail = 0;",
        "  s->iq = 0LL;",
        "  s->iq_size = 0;",
        "  s->qi_enabled = 0;",
        "  s->iq_last_desc_type = 0;",
        "  s->next_frcd_reg = 0;",
        "  s->cap = 0x12008C22260206LL;",
        "  s->ecap = 3842LL;",
        "  if ( x86_iommu->intr_supported )",
        "    s->ecap |= 8uLL;",
        "  vtd_reset_context_cache(s);",
        "  vtd_reset_iotlb(s);",
        "  vtd_define_long(s, 0LL, 0x10u, 0, 0);",
        "  vtd_define_quad(s, 8uLL, s->cap, 0LL, 0LL);",
        "  vtd_define_quad(s, 0x10uLL, s->ecap, 0LL, 0LL);",
        "  vtd_define_long(s, 0x18uLL, 0, 0xFF800000, 0);",
        "  vtd_define_long_wo(s, 0x18uLL, 0xFF800000);",
        "  vtd_define_long(s, 0x1CuLL, 0, 0, 0);",
        "  vtd_define_quad(s, 0x20uLL, 0LL, 0xFFFFFFFFFFFFF000LL, 0LL);",
        "  vtd_define_quad(s, 0x28uLL, 0LL, 0xE0000003FFFFFFFFLL, 0LL);",
        "  vtd_define_quad_wo(s, 0x28uLL, 0x3FFFF0000uLL);",
        "  vtd_define_long(s, 0x34uLL, 0, 0, 0x11u);",
        "  vtd_define_long(s, 0x38uLL, 0x80000000, 0x80000000, 0);",
        "  vtd_define_long(s, 0x3CuLL, 0, 0xFFFFu, 0);",
        "  vtd_define_long(s, 0x40uLL, 0, 0xFFFFFFFC, 0);",
        "  vtd_define_long(s, 0x44uLL, 0, 0, 0);",
        "  vtd_define_long(s, 0x64uLL, 0, 0, 0);",
        "  vtd_define_quad(s, 0x80uLL, 0LL, 0LL, 0LL);",
        "  vtd_define_quad(s, 0x88uLL, 0LL, 0x7FFF0uLL, 0LL);",
        "  vtd_define_quad(s, 0x90uLL, 0LL, 0xFFFFFFFFFFFFF007LL, 0LL);",
        "  vtd_define_long(s, 0x9CuLL, 0, 0, 1u);",
        "  vtd_define_long(s, 0xA0uLL, 0x80000000, 0x80000000, 0);",
        "  vtd_define_long(s, 0xA4uLL, 0, 0xFFFFFFFF, 0);",
        "  vtd_define_long(s, 0xA8uLL, 0, 0xFFFFFFFC, 0);",
        "  vtd_define_long(s, 0xACuLL, 0, 0, 0);",
        "  vtd_define_quad(s, 0xF8uLL, 0LL, 0xB003FFFF00000000LL, 0LL);",
        "  vtd_define_quad(s, 0xF0uLL, 0LL, 0xFFFFFFFFFFFFF07FLL, 0LL);",
        "  vtd_define_quad_wo(s, 0xF0uLL, 0xFFFFFFFFFFFFF07FLL);",
        "  vtd_define_quad(s, 0x220uLL, 0LL, 0LL, 0LL);",
        "  vtd_define_quad(s, 0x228uLL, 0LL, 0LL, 0x8000000000000000LL);",
        "  vtd_define_quad(s, 0xB8uLL, 0LL, 0xFFFFFFFFFFFFF00FLL, 0LL);",
        "}"
    ]
