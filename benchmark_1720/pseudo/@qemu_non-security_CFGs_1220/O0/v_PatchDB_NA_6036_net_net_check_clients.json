{
    "pseudo_code": [
        "__int64 net_check_clients()",
        "{",
        "  int v0; // eax",
        "  __int64 result; // rax",
        "  const char *v2; // rax",
        "  int v3; // [rsp+8h] [rbp-18h]",
        "  int v4; // [rsp+Ch] [rbp-14h]",
        "  _DWORD *i; // [rsp+10h] [rbp-10h]",
        "  int **j; // [rsp+18h] [rbp-8h]",
        "  __int64 k; // [rsp+18h] [rbp-8h]",
        "",
        "  for ( i = (_DWORD *)vlans; i; i = (_DWORD *)*((_QWORD *)i + 3) )",
        "  {",
        "    v3 = 0;",
        "    v4 = 0;",
        "    for ( j = (int **)*((_QWORD *)i + 1); j; j = (int **)j[2] )",
        "    {",
        "      v0 = **j;",
        "      if ( v0 == 1 )",
        "      {",
        "        v3 = 1;",
        "      }",
        "      else if ( v0 && (unsigned int)(v0 - 2) <= 3 )",
        "      {",
        "        v4 = 1;",
        "      }",
        "    }",
        "    if ( v4 && !v3 )",
        "      fprintf(stderr, \"Warning: vlan %d with no nics\\n\", *i);",
        "    if ( v3 && !v4 )",
        "      fprintf(stderr, \"Warning: vlan %d is not connected to host network\\n\", *i);",
        "  }",
        "  result = non_vlan_clients;",
        "  for ( k = non_vlan_clients; k; k = result )",
        "  {",
        "    if ( !*(_QWORD *)(k + 40) )",
        "    {",
        "      if ( **(_DWORD **)k == 1 )",
        "        v2 = \"nic\";",
        "      else",
        "        v2 = \"netdev\";",
        "      fprintf(stderr, \"Warning: %s %s has no peer\\n\", v2, *(const char **)(k + 64));",
        "    }",
        "    result = *(_QWORD *)(k + 16);",
        "  }",
        "  return result;",
        "}"
    ]
}