{
    "pseudo_code": [
        "__int64 __fastcall throttle_is_valid(__int64 a1, __int64 a2)",
        "{",
        "  bool v2; // al",
        "  bool v3; // al",
        "  bool v4; // al",
        "  bool v5; // al",
        "  bool v7; // [rsp+18h] [rbp-8h]",
        "  bool v8; // [rsp+19h] [rbp-7h]",
        "  bool v9; // [rsp+1Ah] [rbp-6h]",
        "  int i; // [rsp+1Ch] [rbp-4h]",
        "",
        "  v2 = *(double *)a1 != 0.0 && (*(double *)(a1 + 40) != 0.0 || *(double *)(a1 + 80) != 0.0);",
        "  v7 = v2;",
        "  v3 = *(double *)(a1 + 120) != 0.0 && (*(double *)(a1 + 160) != 0.0 || *(double *)(a1 + 200) != 0.0);",
        "  v8 = v3;",
        "  v4 = *(double *)(a1 + 8) != 0.0 && (*(double *)(a1 + 48) != 0.0 || *(double *)(a1 + 88) != 0.0);",
        "  v9 = v4;",
        "  v5 = *(double *)(a1 + 128) != 0.0 && (*(double *)(a1 + 168) != 0.0 || *(double *)(a1 + 208) != 0.0);",
        "  if ( v7 || v8 || v9 || v5 )",
        "  {",
        "    error_setg_internal(",
        "      a2,",
        "      file,",
        "      313LL,",
        "      \"throttle_is_valid\",",
        "      \"bps/iops/max total values and read/write values cannot be used at the same time\");",
        "    return 0LL;",
        "  }",
        "  else if ( *(_QWORD *)(a1 + 240)",
        "         && *(double *)(a1 + 120) == 0.0",
        "         && *(double *)(a1 + 160) == 0.0",
        "         && *(double *)(a1 + 200) == 0.0 )",
        "  {",
        "    error_setg_internal(a2, file, 322LL, \"throttle_is_valid\", \"iops size requires an iops value to be set\");",
        "    return 0LL;",
        "  }",
        "  else",
        "  {",
        "    for ( i = 0; i <= 5; ++i )",
        "    {",
        "      if ( *(double *)(a1 + 40LL * i) < 0.0",
        "        || *(double *)(a1 + 40LL * i + 8) < 0.0",
        "        || *(double *)(a1 + 40LL * i) > 1.0e15",
        "        || *(double *)(a1 + 40LL * i + 8) > 1.0e15 )",
        "      {",
        "        error_setg_internal(",
        "          a2,",
        "          file,",
        "          331LL,",
        "          \"throttle_is_valid\",",
        "          \"bps/iops/max values must be within [0, %lld]\",",
        "          1000000000000000LL);",
        "        return 0LL;",
        "      }",
        "      if ( !*(_DWORD *)(a1 + 40LL * i + 32) )",
        "      {",
        "        error_setg_internal(a2, file, 337LL, \"throttle_is_valid\", \"the burst length cannot be 0\");",
        "        return 0LL;",
        "      }",
        "      if ( *(_DWORD *)(a1 + 40LL * i + 32) > 1u && *(double *)(a1 + 40LL * i + 8) == 0.0 )",
        "      {",
        "        error_setg_internal(a2, file, 342LL, \"throttle_is_valid\", \"burst length set without burst rate\");",
        "        return 0LL;",
        "      }",
        "      if ( *(double *)(a1 + 40LL * i + 8) != 0.0 && *(double *)(a1 + 40LL * i) == 0.0 )",
        "      {",
        "        error_setg_internal(",
        "          a2,",
        "          file,",
        "          347LL,",
        "          \"throttle_is_valid\",",
        "          \"bps_max/iops_max require corresponding bps/iops values\");",
        "        return 0LL;",
        "      }",
        "    }",
        "    return 1LL;",
        "  }",
        "}"
    ]
}