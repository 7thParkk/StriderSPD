{
    "pseudo_code": [
        "BlockInfoList *__cdecl qmp_query_block(Error **errp)",
        "{",
        "  BlockInfoList *head; // [rsp+10h] [rbp-30h] BYREF",
        "  Error *local_err; // [rsp+18h] [rbp-28h] BYREF",
        "  BlockInfoList **p_next; // [rsp+20h] [rbp-20h]",
        "  BlockBackend *blk; // [rsp+28h] [rbp-18h]",
        "  BlockInfoList *info; // [rsp+30h] [rbp-10h]",
        "  unsigned __int64 v7; // [rsp+38h] [rbp-8h]",
        "",
        "  v7 = __readfsqword(0x28u);",
        "  head = 0LL;",
        "  p_next = &head;",
        "  local_err = 0LL;",
        "  for ( blk = (BlockBackend *)blk_all_next(0LL); blk; blk = (BlockBackend *)blk_all_next(blk) )",
        "  {",
        "    if ( *(_BYTE *)blk_name(blk) )",
        "    {",
        "      info = (BlockInfoList *)g_malloc0(16LL);",
        "      bdrv_query_info(blk, &info->value, &local_err);",
        "      if ( local_err )",
        "      {",
        "        error_propagate(errp, local_err);",
        "        g_free(info);",
        "        qapi_free_BlockInfoList(head);",
        "        return 0LL;",
        "      }",
        "      *p_next = info;",
        "      p_next = &info->next;",
        "    }",
        "  }",
        "  return head;",
        "}"
    ]
}