{
    "pseudo_code": [
        "__int64 __fastcall uart_read(__int64 a1, unsigned __int64 a2)",
        "{",
        "  __int64 v2; // rax",
        "  unsigned __int64 v4; // [rsp+10h] [rbp-20h]",
        "  unsigned int v5; // [rsp+24h] [rbp-Ch]",
        "",
        "  v5 = 0;",
        "  v4 = a2 >> 2;",
        "  if ( a2 >> 2 > 7 )",
        "    goto LABEL_8;",
        "  v2 = 1LL << v4;",
        "  if ( ((1LL << v4) & 0x9A) != 0 )",
        "  {",
        "    error_report(\"lm32_uart: read access to write only register 0x%016lx\", 4 * v4);",
        "    goto LABEL_9;",
        "  }",
        "  if ( (v2 & 0x64) != 0 )",
        "  {",
        "    v5 = *(_DWORD *)(a1 + 4 * (v4 + 2296) + 8);",
        "    goto LABEL_9;",
        "  }",
        "  if ( (v2 & 1) == 0 )",
        "  {",
        "LABEL_8:",
        "    error_report(\"lm32_uart: read access to unknown register 0x%016lx\", 4 * v4);",
        "    goto LABEL_9;",
        "  }",
        "  v5 = *(_DWORD *)(a1 + 9192);",
        "  *(_DWORD *)(a1 + 9212) &= ~1u;",
        "  uart_update_irq(a1);",
        "  qemu_chr_accept_input(*(_QWORD *)(a1 + 9176));",
        "LABEL_9:",
        "  trace_lm32_uart_memory_read();",
        "  return v5;",
        "}"
    ]
}