{
    "pseudo_code": [
        "BlockStats *__cdecl bdrv_query_stats(const BlockDriverState *bs, bool query_backing)",
        "{",
        "  BlockStats *s; // [rsp+18h] [rbp-18h]",
        "  __int64 device_name; // [rsp+20h] [rbp-10h]",
        "  __int64 node_name; // [rsp+28h] [rbp-8h]",
        "",
        "  s = (BlockStats *)g_malloc0(72LL);",
        "  if ( *(_BYTE *)bdrv_get_device_name(bs) )",
        "  {",
        "    s->has_device = 1;",
        "    device_name = bdrv_get_device_name(bs);",
        "    s->device = (char *)g_strdup(device_name);",
        "  }",
        "  if ( *(_BYTE *)bdrv_get_node_name(bs) )",
        "  {",
        "    s->has_node_name = 1;",
        "    node_name = bdrv_get_node_name(bs);",
        "    s->node_name = (char *)g_strdup(node_name);",
        "  }",
        "  s->stats = (BlockDeviceStats *)g_malloc0(168LL);",
        "  if ( bs->blk )",
        "    bdrv_query_blk_stats(s, bs->blk);",
        "  s->stats->wr_highest_offset = bs->wr_highest_offset;",
        "  if ( bs->file )",
        "  {",
        "    s->has_parent = 1;",
        "    s->parent = bdrv_query_stats(bs->file->bs, query_backing);",
        "  }",
        "  if ( query_backing && bs->backing )",
        "  {",
        "    s->has_backing = 1;",
        "    s->backing = bdrv_query_stats(bs->backing->bs, query_backing);",
        "  }",
        "  return s;",
        "}"
    ]
}