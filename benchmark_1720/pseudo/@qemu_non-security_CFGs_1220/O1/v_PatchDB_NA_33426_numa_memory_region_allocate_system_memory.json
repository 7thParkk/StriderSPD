{
    "pseudo_code": [
        "unsigned __int64 __fastcall memory_region_allocate_system_memory(__int64 a1, __int64 a2, __int64 a3, __int64 a4)",
        "{",
        "  __int64 *v5; // rbx",
        "  __int64 v6; // r13",
        "  const char *canonical_path_component; // rax",
        "  __int64 v8; // r14",
        "  __int64 v9; // r12",
        "  __int64 memory; // rbp",
        "  unsigned __int64 v11; // [rsp+18h] [rbp-40h]",
        "",
        "  v11 = __readfsqword(0x28u);",
        "  if ( nb_numa_nodes && have_memdevs )",
        "  {",
        "    memory_region_init(a1);",
        "    v5 = numa_info;",
        "    v6 = 0LL;",
        "    do",
        "    {",
        "      v8 = *v5;",
        "      v9 = v5[5];",
        "      if ( v9 )",
        "      {",
        "        memory = host_memory_backend_get_memory(v5[5], &error_fatal);",
        "        if ( (unsigned __int8)memory_region_is_mapped(memory) )",
        "        {",
        "          canonical_path_component = (const char *)object_get_canonical_path_component(v9);",
        "          error_report(",
        "            \"memory backend %s is used multiple times. Each -numa option must use a different memdev value.\",",
        "            canonical_path_component);",
        "          exit(1);",
        "        }",
        "        memory_region_add_subregion(a1, v6, memory);",
        "        vmstate_register_ram_global(memory);",
        "        v6 += v8;",
        "      }",
        "      v5 += 8;",
        "    }",
        "    while ( v5 != &numa_info[1024] );",
        "  }",
        "  else",
        "  {",
        "    if ( mem_path )",
        "      memory_region_init_ram_from_file(a1, a2, a3, a4, 0LL);",
        "    else",
        "      memory_region_init_ram(a1, a2, a3, a4, &error_fatal);",
        "    vmstate_register_ram_global(a1);",
        "  }",
        "  return v11 - __readfsqword(0x28u);",
        "}"
    ]
}