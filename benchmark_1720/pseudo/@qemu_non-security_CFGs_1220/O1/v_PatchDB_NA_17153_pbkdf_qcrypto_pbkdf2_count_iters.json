{
    "pseudo_code": [
        "unsigned __int64 __fastcall qcrypto_pbkdf2_count_iters(",
        "        unsigned int a1,",
        "        __int64 a2,",
        "        __int64 a3,",
        "        __int64 a4,",
        "        __int64 a5,",
        "        __int64 a6)",
        "{",
        "  unsigned __int64 v8; // rbx",
        "  unsigned __int64 v9; // rcx",
        "  __int64 v13; // [rsp+10h] [rbp-78h] BYREF",
        "  __int64 v14; // [rsp+18h] [rbp-70h] BYREF",
        "  _BYTE v15[40]; // [rsp+20h] [rbp-68h] BYREF",
        "  unsigned __int64 v16; // [rsp+48h] [rbp-40h]",
        "",
        "  v16 = __readfsqword(0x28u);",
        "  v8 = 0x8000LL;",
        "  while ( 1 )",
        "  {",
        "    if ( (int)qcrypto_pbkdf2_get_thread_cpu(&v13, a6) < 0 )",
        "      return -1LL;",
        "    if ( (int)qcrypto_pbkdf2(a1, a2, a3, a4, a5, v8, v15, 32LL, a6) < 0 )",
        "      return -1LL;",
        "    if ( (int)qcrypto_pbkdf2_get_thread_cpu(&v14, a6) < 0 )",
        "      break;",
        "    v9 = v14 - v13;",
        "    if ( (unsigned __int64)(v14 - v13) > 0x1F4 )",
        "      return 1000 * v8 / v9;",
        "    if ( v9 > 0x63 )",
        "      v8 = 1000 * v8 / v9;",
        "    else",
        "      v8 *= 10LL;",
        "  }",
        "  return -1LL;",
        "}"
    ]
}