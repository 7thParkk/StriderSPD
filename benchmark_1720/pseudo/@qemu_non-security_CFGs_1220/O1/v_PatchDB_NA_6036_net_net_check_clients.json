{
    "pseudo_code": [
        "void net_check_clients()",
        "{",
        "  _DWORD *v0; // rbp",
        "  int v1; // esi",
        "  int **v2; // rax",
        "  int v3; // edx",
        "  int v4; // ecx",
        "  __int64 i; // rbx",
        "  const char *v6; // rcx",
        "",
        "  v0 = (_DWORD *)vlans;",
        "  if ( vlans )",
        "  {",
        "    do",
        "    {",
        "      v2 = (int **)*((_QWORD *)v0 + 1);",
        "      if ( v2 )",
        "      {",
        "        v4 = 0;",
        "        v1 = 0;",
        "        do",
        "        {",
        "          v3 = **v2;",
        "          if ( v3 == 1 )",
        "          {",
        "            v1 = 1;",
        "          }",
        "          else if ( (unsigned int)(v3 - 2) <= 3 )",
        "          {",
        "            v4 = 1;",
        "          }",
        "          v2 = (int **)v2[2];",
        "        }",
        "        while ( v2 );",
        "        if ( !v4 || v1 )",
        "        {",
        "          if ( v1 && !v4 )",
        "            _fprintf_chk(stderr, 2LL, \"Warning: vlan %d is not connected to host network\\n\", *v0);",
        "        }",
        "        else",
        "        {",
        "          _fprintf_chk(stderr, 2LL, \"Warning: vlan %d with no nics\\n\", *v0);",
        "        }",
        "      }",
        "      v0 = (_DWORD *)*((_QWORD *)v0 + 3);",
        "    }",
        "    while ( v0 );",
        "  }",
        "  for ( i = non_vlan_clients; i; i = *(_QWORD *)(i + 16) )",
        "  {",
        "    if ( !*(_QWORD *)(i + 40) )",
        "    {",
        "      v6 = \"nic\";",
        "      if ( **(_DWORD **)i != 1 )",
        "        v6 = \"netdev\";",
        "      _fprintf_chk(stderr, 2LL, \"Warning: %s %s has no peer\\n\", v6, *(const char **)(i + 64));",
        "    }",
        "  }",
        "}"
    ]
}