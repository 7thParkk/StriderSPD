    "pseudo_code": [
        "int **net_check_clients()",
        "{",
        "  int **result; // rax",
        "  int v1; // r12d",
        "  _DWORD *v2; // rbp",
        "  int v3; // esi",
        "  int v4; // edx",
        "  int v5; // ecx",
        "  __int64 i; // rbx",
        "  const char *v7; // rcx",
        "",
        "  result = (int **)&default_net;",
        "  v1 = default_net;",
        "  if ( !default_net )",
        "  {",
        "    v2 = (_DWORD *)vlans;",
        "    if ( vlans )",
        "    {",
        "      do",
        "      {",
        "        result = (int **)*((_QWORD *)v2 + 1);",
        "        if ( result )",
        "        {",
        "          v5 = v1;",
        "          v3 = v1;",
        "          do",
        "          {",
        "            v4 = **result;",
        "            if ( v4 == 1 )",
        "            {",
        "              v3 = 1;",
        "            }",
        "            else if ( (unsigned int)(v4 - 2) <= 3 )",
        "            {",
        "              v5 = 1;",
        "            }",
        "            result = (int **)result[2];",
        "          }",
        "          while ( result );",
        "          if ( !v5 || v3 )",
        "          {",
        "            if ( v3 && !v5 )",
        "              result = (int **)_fprintf_chk(stderr, 2LL, \"Warning: vlan %d is not connected to host network\\n\", *v2);",
        "          }",
        "          else",
        "          {",
        "            result = (int **)_fprintf_chk(stderr, 2LL, \"Warning: vlan %d with no nics\\n\", *v2);",
        "          }",
        "        }",
        "        v2 = (_DWORD *)*((_QWORD *)v2 + 3);",
        "      }",
        "      while ( v2 );",
        "    }",
        "    for ( i = non_vlan_clients; i; i = *(_QWORD *)(i + 16) )",
        "    {",
        "      if ( !*(_QWORD *)(i + 40) )",
        "      {",
        "        v7 = \"nic\";",
        "        if ( **(_DWORD **)i != 1 )",
        "          v7 = \"netdev\";",
        "        result = (int **)_fprintf_chk(stderr, 2LL, \"Warning: %s %s has no peer\\n\", v7, *(const char **)(i + 64));",
        "      }",
        "    }",
        "  }",
        "  return result;",
        "}"
    ]
}