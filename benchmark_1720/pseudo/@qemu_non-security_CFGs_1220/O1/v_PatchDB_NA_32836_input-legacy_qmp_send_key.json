{
    "pseudo_code": [
        "void __cdecl qmp_send_key(KeyValueList *keys, bool has_hold_time, int64_t hold_time, Error **errp)",
        "{",
        "  KeyValue *v4; // rax",
        "  KeyValue *v5; // rax",
        "  unsigned int hold_timea; // [rsp+8h] [rbp-28h]",
        "  KeyValueList *p; // [rsp+28h] [rbp-8h]",
        "  KeyValueList *pa; // [rsp+28h] [rbp-8h]",
        "",
        "  hold_timea = hold_time;",
        "  if ( !has_hold_time )",
        "    hold_timea = 0;",
        "  for ( p = keys; p; p = p->next )",
        "  {",
        "    v4 = copy_key_value(p->value);",
        "    qemu_input_event_send_key(0LL, v4, 1LL);",
        "    qemu_input_event_send_key_delay(hold_timea);",
        "  }",
        "  for ( pa = keys; pa; pa = pa->next )",
        "  {",
        "    v5 = copy_key_value(pa->value);",
        "    qemu_input_event_send_key(0LL, v5, 0LL);",
        "    qemu_input_event_send_key_delay(hold_timea);",
        "  }",
        "}"
    ]
}