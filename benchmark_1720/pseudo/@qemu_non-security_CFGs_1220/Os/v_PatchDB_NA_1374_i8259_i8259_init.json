{
    "pseudo_code": [
        "__int64 __fastcall i8259_init(__int64 a1, __int64 a2)",
        "{",
        "  __int64 v2; // rbx",
        "  __int64 inited; // rax",
        "  __int64 v4; // r13",
        "  __int64 v5; // rbp",
        "  __int64 v6; // r12",
        "  __int64 v7; // rax",
        "  __int64 v8; // rbp",
        "",
        "  v2 = g_malloc(128LL);",
        "  inited = i8259_init_chip(\"isa-i8259\", a1, 1LL);",
        "  v4 = 0LL;",
        "  v5 = object_dynamic_cast_assert(inited, \"device\", &LC0, 478LL, \"i8259_init\");",
        "  qdev_connect_gpio_out(v5, 0LL, a2);",
        "  do",
        "  {",
        "    *(_QWORD *)(v2 + 8 * v4) = qdev_get_gpio_in(v5, (unsigned int)v4);",
        "    ++v4;",
        "  }",
        "  while ( v4 != 8 );",
        "  v6 = 0LL;",
        "  isa_pic = v5;",
        "  v7 = i8259_init_chip(\"isa-i8259\", a1, 0LL);",
        "  v8 = object_dynamic_cast_assert(v7, \"device\", &LC0, 488LL, \"i8259_init\");",
        "  qdev_connect_gpio_out(v8, 0LL, *(_QWORD *)(v2 + 16));",
        "  do",
        "  {",
        "    *(_QWORD *)(v2 + 8 * v6 + 64) = qdev_get_gpio_in(v8, (unsigned int)v6);",
        "    ++v6;",
        "  }",
        "  while ( v6 != 8 );",
        "  slave_pic = object_dynamic_cast_assert(v8, \"pic-common\", &LC0, 495LL, \"i8259_init\");",
        "  return v2;",
        "}"
    ]
}