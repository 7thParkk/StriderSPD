{
    "pseudo_code": [
        "unsigned __int64 __fastcall qcrypto_pbkdf2_count_iters(",
        "        unsigned int a1,",
        "        __int64 a2,",
        "        __int64 a3,",
        "        __int64 a4,",
        "        __int64 a5,",
        "        __int64 a6)",
        "{",
        "  unsigned __int64 v10; // rbx",
        "  __int64 thread_cpu; // rax",
        "  unsigned __int64 v13; // rcx",
        "  __int64 v14; // [rsp+18h] [rbp-70h] BYREF",
        "  __int64 v15; // [rsp+20h] [rbp-68h] BYREF",
        "  _BYTE v16[32]; // [rsp+28h] [rbp-60h] BYREF",
        "  unsigned __int64 v17; // [rsp+48h] [rbp-40h]",
        "",
        "  v10 = 0x8000LL;",
        "  v17 = __readfsqword(0x28u);",
        "  while ( 1 )",
        "  {",
        "    thread_cpu = qcrypto_pbkdf2_get_thread_cpu(&v14, a6);",
        "    if ( (int)thread_cpu < 0",
        "      || (int)qcrypto_pbkdf2(a1, a2, a3, a4, a5, v10, v16, 32LL, a6, thread_cpu) < 0",
        "      || (int)qcrypto_pbkdf2_get_thread_cpu(&v15, a6) < 0 )",
        "    {",
        "      return -1LL;",
        "    }",
        "    v13 = v15 - v14;",
        "    if ( (unsigned __int64)(v15 - v14) > 0x1F4 )",
        "      break;",
        "    if ( v13 > 0x63 )",
        "      v10 = 1000 * v10 / v13;",
        "    else",
        "      v10 *= 10LL;",
        "  }",
        "  return 1000 * v10 / v13;",
        "}"
    ]
}